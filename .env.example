# Plantilla de credenciales. Copiar como .env y llenar con los valores
# reales de TiDB Cloud (botón "Connect" en la consola). El archivo .env
# NUNCA se sube a git.
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=estacionamiento_db
DB_USER=tu_usuario.root
DB_PASSWORD=tu_password
